# 复制为 .env 后填写真实值：cp .env.example .env
# 切勿将 .env 提交到 git

# ---------- Ark（火山方舟）----------
# OpenAI SDK 的 base_url 不要带 /responses 后缀
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=

# ---------- Aliyun（百炼 / DashScope）----------
# 推荐新路径；旧路径 /api/v2/apps/protocols/compatible-mode/v1 仍可用但即将下线
ALI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALI_API_KEY=

# ---------- 模型 ID（Responses API）----------
MODEL_DEEPSEEK_V4_FLASH=deepseek-v4-flash-260425
MODEL_DEEPSEEK_V4_PRO=deepseek-v4-pro-260425
MODEL_DOUBAO_SEED_2_1_TURBO=doubao-seed-2-1-turbo-260628
MODEL_QWEN37_PLUS=qwen3.7-plus
MODEL_QWEN37_MAX=qwen3.7-max
MODEL_QWEN38_MAX=qwen3.8-max

# ---------- 默认生成参数（可选）----------
# 省略则代码使用下列默认
DEFAULT_TEMPERATURE=1.0
DEFAULT_TOP_P=1.0
# 烟测用小值；整集翻译见文档建议，勿盲目锁 32768
DEFAULT_MAX_OUTPUT_TOKENS=131072
